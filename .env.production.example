# Production server env template. Copy to a local file (e.g. .env.production) or
# paste values into CloudBase 云托管 / 腾讯云控制台环境变量。Never commit real secrets.
#
# Production identity comes from CloudBase authenticated requests.

# CloudBase PostgreSQL shared cluster access through the server-side RDB SDK.
# This must be a backend API Key (service_role), held only by CloudRun.
CLOUDBASE_APIKEY=

# Strong random secret for JWT signing (required in production)
JWT_SECRET=

# DeepSeek — server only; never put these in apps/miniapp
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Public legal disclosures. Keep the exact same values in the mini-program
# build environment; these fields are compiled into the client for display.
LEGAL_OPERATOR_NAME=
LEGAL_PRIVACY_CONTACT=
LEGAL_COMPLAINT_CONTACT=
LEGAL_COMPLAINT_RESPONSE_TIME=
LEGAL_AGE_SCOPE=
LEGAL_STORAGE_REGION=
LEGAL_RETENTION_DESCRIPTION=
MINIPROGRAM_FILING_NO=
DEEPSEEK_SERVICE_FILING_NO=
DEEPSEEK_ALGORITHM_FILING_NO=
DEEPSEEK_DATA_HANDLING=
DEEPSEEK_DATA_REGION=

CLOUDBASE_ENV_ID=littlemo-d2gy2ec0dd102163
CLOUDBASE_SERVICE_NAME=littlemo-api

# Optional: only needed if you also serve Taro H5 against this API
# CORS_ORIGINS=
