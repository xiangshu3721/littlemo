// 有点情绪 cloud models (PostgreSQL).
// Mini-program diary / period insight persist here for logged-in users.
// Web IndexedDB remains local-first and does not write these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String    @id @default(cuid())
  openid                      String    @unique
  unionid                     String?
  nickname                    String?
  avatar                      String?
  termsVersion                String?
  termsConsentedAt            DateTime?
  sensitiveInfoConsentVersion String?
  sensitiveInfoConsentedAt    DateTime?
  aiDataConsentVersion        String?
  aiDataConsentedAt           DateTime?
  adultAgeConfirmedAt         DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  notes    Note[]
  messages ChatMessage[]
  sessions DiarySession[]
  reports  PeriodReport[]
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  clientId  String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, clientId])
  @@index([userId, createdAt])
}

model ChatMessage {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  model     String?
  sessionId String?
  session   DiarySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  clientId  String?
  createdAt DateTime      @default(now())

  @@unique([userId, clientId])
  @@index([userId, createdAt])
  @@index([userId, sessionId])
}

model DiarySession {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day             String
  startedAt       DateTime
  endedAt         DateTime?
  title           String
  mood            String?
  analysis        Json?
  analysisStatus  String    @default("idle")
  analysisError   String?
  deletedAt       DateTime?
  status          String    @default("active")
  weather         String?
  stress          Int?
  energy          Int?
  primaryEmotions Json?
  thoughts        Json?
  coreNeeds       Json?
  coreTheme       String?
  lastUserAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages ChatMessage[]

  @@index([userId, startedAt])
}

model PeriodReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodId    String
  kind        String
  label       String
  generatedAt DateTime
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, periodId])
  @@index([userId, generatedAt])
}
