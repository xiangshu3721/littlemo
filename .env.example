# Server only. Copy to .env.local (Next) and optionally .env (Prisma CLI).
# Never commit real values. The mini-program never sees these keys.

# PostgreSQL for User / Note / ChatMessage / DiarySession / PeriodReport (mini-program + cloud API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/littlemo

# Sign session JWTs. Required in every deployed environment.
JWT_SECRET=

# DeepSeek — used by web /api/chat|/api/analyze|/api/period and mini-program companion chat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# CloudBase container identity headers are enabled only on the production service.
CLOUDBASE_ENV_ID=
CLOUDBASE_SERVICE_NAME=littlemo-api

# Optional: comma-separated origins for Taro H5 local testing (WeChat native does not use CORS)
# CORS_ORIGINS=http://localhost:10086,http://127.0.0.1:10086

# WeChat content security (msgSecCheck). Required for mini-program UGC review.
# AppID defaults to the littlemo mini-program if omitted.
WECHAT_APPID=wx6f03736d4996c4e4
WECHAT_APPSECRET=
