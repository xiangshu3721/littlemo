# Server only. Copy to .env.local (Next) and optionally .env (Prisma CLI).
# Never commit real values. The mini-program never sees these keys.

# PostgreSQL for User / Note / ChatMessage (mini-program + cloud API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/littlemo

# WeChat mini-program jscode2session
WECHAT_APPID=
WECHAT_SECRET=

# Sign session JWTs. Required in production. Mock mode falls back to a local-only secret.
JWT_SECRET=

# 1 = skip real WeChat and accept any non-empty `code` (creates/upserts a mock user)
WECHAT_MOCK=1

# DeepSeek — used by web /api/chat|/api/analyze|/api/period and mini-program companion chat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: comma-separated origins for Taro H5 local testing (WeChat native does not use CORS)
# CORS_ORIGINS=http://localhost:10086,http://127.0.0.1:10086
